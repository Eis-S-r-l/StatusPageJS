# Copy this file to /etc/nginx/sites-available/eis-status-page and replace
# status.example.com. Certbot will add HTTPS and certificate directives.

server {
    listen 80;
    listen [::]:80;
    server_name status.example.com;

    # The appearance form can upload three assets of up to 2 MB each in one
    # request. The application applies its own stricter validation as well.
    client_max_body_size 8m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # This example deliberately does not define a Content-Security-Policy.
    # If a CSP is added here or by a shared Nginx include, Turnstile requires
    # https://challenges.cloudflare.com in both script-src and frame-src.
    # Pre-clearance also requires 'self' in connect-src. Merge those sources
    # into the complete policy instead of adding a second CSP header.

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
