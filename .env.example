# Application
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Rome
# Container release to deploy: latest, a GitHub Release tag, or sha-<full-commit-sha>
CONTAINER_IMAGE_TAG=latest

# PostgreSQL
DATABASE_URL=postgresql://eis_status:eis_status@localhost:5432/eis_status
POSTGRES_PASSWORD=replace-with-a-long-random-password

# AWS Cognito admin authentication
COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_example
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://example.auth.eu-west-1.amazoncognito.com
COGNITO_ADMIN_GROUP=StatusPageAdmins
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/en
SESSION_SECRET=
ADMIN_DEV_BYPASS=false

# Cloudflare Turnstile public subscription protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Amazon SES
AWS_REGION=eu-west-1
SES_FROM_EMAIL=status@example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Webex (optional)
WEBEX_BOT_TOKEN=
WEBEX_WEBHOOK_SECRET=
WEBEX_BOT_EMAIL=

# Local worker
WORKER_POLL_INTERVAL_MS=5000
UPTIME_ACTIVE_REFRESH_MS=60000
